<view class="page records-page">
  <view class="eyebrow">MY VISITSAFE</view><view class="title">我的记录</view><view class="subtitle">每一次学习，让下一次到访更安心。</view>
  <view class="record-stats section"><view><view class="metric">{{visitCount}}</view><text class="muted small">到访登记</text></view><view><view class="metric blue">{{pendingCount}}</view><text class="muted small">待完成培训</text></view><view><view class="metric green">{{completeCount}}</view><text class="muted small">已通过培训</text></view></view>
  <view class="search row"><image class="search-icon" src="/assets/search.svg" aria-hidden="true" /><input class="grow search-input" value="{{keyword}}" bindinput="onSearch" placeholder="搜索姓名、单位或车牌" aria-label="搜索记录" /><button wx:if="{{keyword}}" class="text-button" bindtap="onClearSearch">清除</button></view>
  <view class="segment"><button class="{{tab === 'visits' ? 'selected' : ''}}" data-tab="visits" bindtap="onTab">登记记录</button><button class="{{tab === 'tasks' ? 'selected' : ''}}" data-tab="tasks" bindtap="onTab">培训记录</button></view>
  <view wx:if="{{tab === 'visits'}}" class="stack">
    <button wx:for="{{visits}}" wx:key="id" class="card record-card" data-id="{{item.id}}" bindtap="onVisit" hover-class="press">
      <view class="row"><image class="icon" src="/assets/{{item.icon}}.svg" aria-hidden="true" /><view class="grow"><view class="section-title">{{item.title}}</view><view class="muted small">{{item.date}}</view></view><text class="status {{item.passed ? 'complete' : ''}}">{{item.passed ? '已完成' : '培训中'}}</text></view>
      <view class="divider"></view><view class="row"><view class="grow"><view>{{item.names}}</view><view wx:if="{{item.type === 'logistics'}}" class="muted">{{item.plates}}</view><view class="muted">{{item.type === 'training' ? '培训方案：通用安全培训' : '访问区域：' + item.areaNames}}</view><view class="small muted">培训进度：{{item.complete}} / {{item.total}} 项</view></view><text class="chevron">›</text></view>
    </button>
    <view wx:if="{{!visits.length}}" class="card empty"><image src="/assets/book.svg" aria-hidden="true" /><view class="section-title">{{keyword ? '未找到匹配记录' : '还没有到访记录'}}</view><view class="subtitle">{{keyword ? '试试其他姓名、单位或车牌。' : '完成登记后，记录会保存在这里。'}}</view><button wx:if="{{!keyword}}" class="primary" bindtap="onHome">前往首页登记</button></view>
  </view>
  <view wx:else class="stack">
    <button wx:for="{{tasks}}" wx:key="id" class="card record-card" data-id="{{item.id}}" bindtap="onTask" hover-class="press"><view class="row"><view class="icon-box"><image class="icon" src="/assets/{{item.icon}}.svg" aria-hidden="true" /></view><view class="grow"><view class="section-title">{{item.title}}</view><view class="muted">{{item.visitLabel}} · {{item.date}}</view></view></view><view class="divider"></view><view class="row between"><text class="status {{item.passed ? 'complete' : 'active'}}">{{item.status}}</text><text wx:if="{{item.lastResult}}">{{item.lastResult.score}} 分</text><text class="muted small">{{item.done}} / {{item.lessonCount}} 个视频</text><text class="chevron">›</text></view></button>
    <view wx:if="{{!tasks.length}}" class="card empty"><image src="/assets/book.svg" aria-hidden="true" /><view class="section-title">{{keyword ? '未找到匹配培训' : '暂无培训任务'}}</view><view class="subtitle">完成到访登记后，会自动匹配培训方案。</view></view>
  </view>
  <view class="local-note">记录仅保存在当前设备 · Demo 演示版</view>
</view>
