.record-stats { display: flex; justify-content: space-around; padding: 28rpx 0; background: white; border: 1rpx solid var(--border); border-radius: 24rpx; text-align: center; }
.metric { font-size: 46rpx; margin-bottom: 8rpx; }
.blue { color: var(--primary); } .green { color: var(--green); }
.search { margin-top: 28rpx; background: white; border: 1rpx solid var(--border); border-radius: 16rpx; padding: 4rpx 20rpx; min-height: 94rpx; }
.search-icon { width: 36rpx; height: 36rpx; }
.search-input { font-size: 27rpx; height: 80rpx; }
.record-card { width: 100%; text-align: left; padding: 28rpx; }
.record-card .section-title { font-size: 28rpx; }
.local-note { text-align: center; font-size: 22rpx; color: var(--muted); padding-top: 36rpx; }
