.completion-hero { text-align: center; padding: 56rpx 0 48rpx; }.completion-hero .title { font-size: 38rpx; }.certificate { width: 152rpx; height: 174rpx; margin: 0 auto 48rpx; border-radius: 20rpx; background: linear-gradient(145deg,#d9e9ff,#aecbfa); padding: 36rpx 26rpx; position: relative; transform: rotate(-4deg); box-shadow: 14rpx 14rpx 0 #edf3fc; }.certificate-line { width: 85%; height: 12rpx; border-radius: 10rpx; background: white; margin-bottom: 20rpx; }.certificate-line.long { width: 100%; }.certificate-line.short { width: 56%; }.certificate-seal { width: 60rpx; height: 60rpx; border-radius: 50%; background: #159647; color: white; position: absolute; right: -14rpx; bottom: -10rpx; line-height: 60rpx; font-size: 40rpx; border: 4rpx solid white; }.green { color: var(--green); }.card { font-size: 27rpx; }
