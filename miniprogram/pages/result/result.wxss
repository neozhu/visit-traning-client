.result-hero { padding: 56rpx 0 44rpx; text-align: center; }.result-mark { width: 140rpx; height: 140rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 28rpx; box-shadow: 0 12rpx 30rpx rgba(23,95,53,.12); }.result-mark image { width: 76rpx; height: 76rpx; }.result-mark.passed { background: linear-gradient(140deg,#23b668,#129147); }.result-mark.failed { background: #d88525; }.result-title { font-size: 36rpx; font-weight: 700; }.passed-text,.green { color: var(--green); }.failed-text { color: #a86016; }
.score-card { background: linear-gradient(145deg,#eef4fc,#ffffff); }.score-row { text-align: center; padding: 16rpx 0 32rpx; }.score { font-size: 88rpx; font-weight: 700; line-height: 1.3; }.score text,.pass-score text { font-size: 27rpx; margin-left: 4rpx; font-weight: 400; }.pass-score { font-size: 66rpx; font-weight: 600; }.score-divider { width: 1rpx; height: 84rpx; background: #d9e1ee; }.answer-summary { padding: 24rpx 28rpx; background: white; border-radius: 16rpx; font-size: 26rpx; }.red-text,.wrong-answer { color: var(--red); }.wrong-answer,.right-answer { margin-top: 16rpx; font-size: 27rpx; }.right-answer { color: var(--green); }
