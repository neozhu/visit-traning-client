<view class="page with-footer">
  <block wx:if="{{task && lesson}}">
    <view class="row between"><view class="section-title">{{lesson.title}}</view><text class="muted small">{{selected + 1}} / {{lessons.length}}</text></view>
    <view class="subtitle">{{title}}</view>
    <video id="lesson-video" class="lesson-video section" src="{{lesson.source}}" poster="/assets/lesson-cover.png" controls show-center-play-btn enable-progress-gesture="{{watched}}" show-progress="{{watched}}" bindloadedmetadata="onMetadata" bindtimeupdate="onTimeUpdate" bindended="onEnded" binderror="onVideoError" object-fit="contain" />
    <view wx:if="{{videoError}}" class="error-banner">{{videoError}}</view>
    <view class="row between lesson-caption"><text class="muted small">短版教学演示 · {{lesson.duration}}</text><text class="status {{watched ? 'complete' : 'active'}}">{{watched ? '已完成观看' : '观看进度 ' + progress + '%'}}</text></view>
    <view class="section-title section">视频简介</view><view class="card section lesson-description">{{lesson.description}}</view>
    <button wx:if="{{!allDone}}" class="primary section complete-video" disabled="{{!watched}}" bindtap="onContinue" hover-class="press">{{watched ? '继续下一段视频' : '请完整观看本段视频'}}</button>
    <view wx:else class="info-banner">✓ 全部视频已完成，可以开始在线考试。</view>
    <view class="section-title section">学习目录</view>
    <view class="stack section"><button wx:for="{{lessons}}" wx:key="id" class="card lesson-row {{selected === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="onLesson" hover-class="press"><view class="row"><view class="lesson-number">{{index + 1}}</view><view class="grow"><view>{{item.title}}</view><view class="muted small">{{item.duration}}</view></view><text class="lesson-check {{item.done ? 'done' : ''}}">{{item.done ? '✓' : '○'}}</text></view></button></view>
  </block>
  <view wx:else class="card empty"><view class="section-title">培训任务不存在</view><view class="subtitle">记录可能已删除，请返回任务列表。</view></view>
</view>
<view class="footer"><view class="footer-inner"><button class="secondary" bindtap="onTasks">任务列表</button><button wx:if="{{task}}" class="primary begin-exam" disabled="{{!allDone}}" bindtap="onExam" hover-class="press">开始考试</button></view></view>
