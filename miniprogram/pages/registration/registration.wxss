.steps { display: flex; align-items: flex-start; padding: 8rpx 12rpx 16rpx; }
.step { text-align: center; width: 140rpx; color: #778297; font-size: 24rpx; flex-shrink: 0; }
.step-number { width: 48rpx; height: 48rpx; line-height: 46rpx; border: 2rpx solid #c5cfdf; border-radius: 50%; margin: 0 auto 12rpx; background: white; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }
.step-number image { width: 32rpx; height: 32rpx; }
.step.current, .step.done { color: var(--primary); }
.step.current .step-number, .step.done .step-number { background: var(--primary); border-color: var(--primary); color: white; }
.step-line { height: 2rpx; background: #d7dfeb; flex: 1; margin-top: 24rpx; }
.step-line.done { background: var(--primary); }
.registration-page, .registration-footer, .overlay { --primary: #246BFD; --text: #192B43; }
.registration-page { max-width: 600px; }
.registration-intro { margin: 24rpx 0 28rpx; }
.registration-intro .title { font-size: 22px; }
.form-section { margin-top: 24rpx; padding: 28rpx; border-radius: 14px; box-shadow: 0 2rpx 8rpx rgba(25,43,67,.025); }
.form-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.form-heading .section-title { font-size: 17px; color: #192B43; }
.form-hint, .form-note { color: #687B91; font-size: 12px; line-height: 1.6; }
.form-note { margin-top: 14rpx; }
.required { color: #B8453B; margin-left: 4rpx; }
.select-control { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 94rpx; padding: 18rpx 22rpx; border: 2rpx solid #E1E7F0; border-radius: 8px; background: #F7F9FC; font-size: 15px; }
.select-control image { width: 16px; height: 16px; flex-shrink: 0; opacity: .6; transform: rotate(90deg); }
.placeholder { color: #7D8CA0; }
.form-section .field-label { font-size: 13px; color: #364C65; }
.form-section .field input { font-size: 15px; border-radius: 8px; background: #F7F9FC; }
.field input.invalid, .select-control.invalid { border-color: #CF6A60; }
.field-error { color: #B43A32; font-size: 12px; margin-top: 10rpx; }
.optional-tag { font-size: 12px; color: #61768D; background: #F1F5FA; padding: 4rpx 12rpx; border-radius: 6px; }
.add-list-button { width: 100% !important; margin: 22rpx 0 0 !important; min-height: 88rpx; padding: 20rpx 16rpx; border: 1rpx solid #DCE7F8; border-radius: 8px; background: #F4F8FF; color: #246BFD; font-size: 14px; }
.roster-list { gap: 0; }
.roster-card { padding: 24rpx 0 16rpx; border-bottom: 1rpx solid #E8EEF5; }
.roster-card:last-child { border-bottom: 0; }
.roster-empty { text-align: center; color: #687B91; padding: 32rpx 0 8rpx; font-size: 14px; }
.inherited-company { background: #F4F7FB; padding: 20rpx 22rpx; border-radius: 8px; color: #516880; font-size: 14px; }
.summary-field { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; margin-top: 20rpx; font-size: 14px; }
.summary-field .muted { flex-shrink: 0; font-size: 13px; }
.summary-value { text-align: right; min-width: 0; word-break: break-all; }
.list-number { width: 48rpx; height: 54rpx; background: #edf2f8; border-radius: 12rpx; text-align: center; line-height: 54rpx; align-self: flex-start; }
.person-name { font-weight: 600; font-size: 16px; }
.entry-actions { justify-content: flex-end; margin: 8rpx -12rpx -12rpx; }
.entry-actions button { min-width: 100rpx; }
.demo-data { margin: 16rpx auto 0; }
.area-card { display: flex; align-items: center; gap: 22rpx; text-align: left; padding: 24rpx; border: 2rpx solid #e4eaf3; }
.area-card.selected { border-color: #9cbeff; background: #f6f9ff; }
.area-illustration { width: 120rpx; height: 136rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: #e7effc; }
.area-illustration.purple { background: #eee9fb; }
.area-illustration.green { background: #e5f3ed; }
.area-illustration image { width: 74rpx; height: 74rpx; }
.area-caption { font-size: 18rpx; letter-spacing: 2rpx; color: #687fa1; margin-top: 10rpx; }
.check { width: 34rpx; height: 34rpx; border: 2rpx solid #b9c6da; border-radius: 8rpx; flex-shrink: 0; line-height: 30rpx; text-align: center; color: white; font-size: 25rpx; }
.check.checked { border-color: var(--primary); background: var(--primary); }
.check image { width: 26rpx; height: 26rpx; display: block; margin: 2rpx auto; }
.plan-line { display: flex; align-items: center; gap: 16rpx; padding: 8rpx 0; font-size: 28rpx; }
.plan-tick { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.overlay { position: fixed; inset: 0; background: rgba(17,30,49,.5); display: flex; align-items: center; justify-content: center; z-index: 20; }
.notice-modal { width: 640rpx; max-width: 92%; padding: 40rpx 32rpx 20rpx; background: white; border-radius: 32rpx; box-shadow: 0 24rpx 80rpx rgba(17,30,49,.18); }
.notice-shield { width: 104rpx; height: 104rpx; display: block; margin: 0 auto 16rpx; }
.notice-title { text-align: center; font-size: 42rpx; font-weight: 700; }
.notice-subtitle { text-align: center; color: var(--muted); font-size: 24rpx; margin-top: 8rpx; }
.notice-copy { margin: 28rpx 0; font-size: 27rpx; line-height: 1.8; }
.notice-copy view { margin-bottom: 10rpx; }
.notice-agree { display: flex; align-items: center; font-size: 25rpx; padding: 16rpx 0 28rpx; }
.notice-agree checkbox { transform: scale(.8); margin-left: -10rpx; }
.notice-modal .text-button { width: 100%; }
.editor-overlay { align-items: flex-end; }
.editor-sheet { position: relative; background: white; width: 100%; border-radius: 32rpx 32rpx 0 0; padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); }
.editor-header { min-height: 88rpx; padding-right: 80rpx; }
.close-editor { position: absolute; top: 20rpx; right: 20rpx; display: flex; align-items: center; justify-content: center; width: 88rpx !important; height: 88rpx; padding: 0; margin: 0 !important; background: transparent; }
.close-icon { width: 32rpx; height: 32rpx; }
.editor-scroll { max-height: 62vh; height: 740rpx; }
.sheet-bottom-space { height: 28rpx; }
.accompanying-plate { margin: 0 !important; padding: 20rpx 22rpx; min-height: 88rpx; border: 1rpx solid #DCE7F8; border-radius: 8px; background: #F4F8FF; color: #192B43; font-size: 17px; font-weight: 600; letter-spacing: 2rpx; text-align: left; }
