<view class="page with-footer registration-page">
  <view class="steps">
    <view class="step {{step === 1 ? 'current' : ''}} {{step > 1 ? 'done' : ''}}"><view class="step-number"><image wx:if="{{step > 1}}" src="/assets/check-white.svg" aria-hidden="true" /><text wx:else>1</text></view><text>登记信息</text></view>
    <view class="step-line {{step > 1 ? 'done' : ''}}"></view>
    <view class="step {{step === 2 ? 'current' : ''}} {{step > 2 ? 'done' : ''}}"><view class="step-number"><image wx:if="{{step > 2}}" src="/assets/check-white.svg" aria-hidden="true" /><text wx:else>2</text></view><text>访问区域</text></view>
    <view class="step-line {{step > 2 ? 'done' : ''}}"></view>
    <view class="step {{step === 3 ? 'current' : ''}}"><view class="step-number">3</view><text>确认提交</text></view>
  </view>
  <block wx:if="{{step === 1}}">
    <view class="registration-intro"><view class="title">{{title}}</view><view class="subtitle">填写本次到访安排，再添加同行人员或车辆。</view></view>
    <view class="card form-section">
      <view class="form-heading"><text class="section-title">预约信息</text><text class="form-hint">整单共用</text></view>
      <view class="field" id="field-appointmentDate"><text class="field-label">预约日期 <text class="required">*</text></text>
        <picker mode="date" value="{{draft.appointmentDate || today}}" start="{{today}}" bindchange="onDateChange" aria-label="预约日期">
          <view class="select-control {{infoErrors.appointmentDate ? 'invalid' : ''}}"><text class="{{draft.appointmentDate ? '' : 'placeholder'}}">{{draft.appointmentDate || '请选择预约日期'}}</text><image src="/assets/chevron.svg" aria-hidden="true" /></view>
        </picker><view wx:if="{{infoErrors.appointmentDate}}" class="field-error">{{infoErrors.appointmentDate}}</view>
      </view>
      <view class="field" id="field-timeSlot"><text class="field-label">到访时段 <text class="required">*</text></text>
        <picker mode="selector" range="{{timeSlots}}" value="{{timeSlotIndex >= 0 ? timeSlotIndex : 0}}" data-field="timeSlot" bindchange="onInfoSelect" aria-label="到访时段">
          <view class="select-control {{infoErrors.timeSlot ? 'invalid' : ''}}"><text class="{{draft.timeSlot ? '' : 'placeholder'}}">{{draft.timeSlot || '请选择到访时段'}}</text><image src="/assets/chevron.svg" aria-hidden="true" /></view>
        </picker><view wx:if="{{infoErrors.timeSlot}}" class="field-error">{{infoErrors.timeSlot}}</view>
      </view>
    </view>
    <view wx:if="{{type === 'visitor'}}" class="card form-section">
      <view class="form-heading"><text class="section-title">到访信息</text><text class="form-hint">整单共用</text></view>
      <label class="field" id="field-hostName"><text class="field-label">被访人 <text class="required">*</text></text><input class="{{infoErrors.hostName ? 'invalid' : ''}}" value="{{draft.hostName}}" data-field="hostName" bindinput="onInfoInput" placeholder="请输入被访人姓名" maxlength="30" cursor-spacing="120" aria-label="被访人" /><view wx:if="{{infoErrors.hostName}}" class="field-error">{{infoErrors.hostName}}</view></label>
      <view class="field" id="field-visitReason"><text class="field-label">到访事由 <text class="required">*</text></text>
        <picker mode="selector" range="{{visitReasons}}" value="{{reasonIndex >= 0 ? reasonIndex : 0}}" data-field="visitReason" bindchange="onInfoSelect" aria-label="到访事由">
          <view class="select-control {{infoErrors.visitReason ? 'invalid' : ''}}"><text class="{{draft.visitReason ? '' : 'placeholder'}}">{{draft.visitReason || '请选择到访事由'}}</text><image src="/assets/chevron.svg" aria-hidden="true" /></view>
        </picker><view wx:if="{{infoErrors.visitReason}}" class="field-error">{{infoErrors.visitReason}}</view>
      </view>
    </view>
    <view wx:if="{{type === 'contractor'}}" class="card form-section">
      <view class="form-heading"><text class="section-title">施工信息</text><text class="form-hint">整单共用</text></view>
      <label wx:for="{{constructionFields}}" wx:key="key" class="field" id="field-{{item.key}}"><text class="field-label">{{item.label}} <text class="required">*</text></text><input class="{{infoErrors[item.key] ? 'invalid' : ''}}" value="{{draft[item.key]}}" data-field="{{item.key}}" bindinput="onInfoInput" placeholder="{{item.placeholder}}" maxlength="{{item.maxlength}}" cursor-spacing="120" aria-label="{{item.label}}" /><view wx:if="{{infoErrors[item.key]}}" class="field-error">{{infoErrors[item.key]}}</view></label>
      <view class="form-note">施工位置填写具体地点；下一步选择访问区域，用于匹配培训。</view>
    </view>
    <view class="card form-section roster-section">
    <view class="form-heading"><text class="section-title">{{type === 'logistics' ? '车辆及司机' : (type === 'contractor' ? '施工人员' : '来访人员')}}</text><text class="form-hint">{{rows.length}} {{type === 'logistics' ? '辆' : '人'}}</text></view>
    <view class="stack roster-list">
      <view wx:for="{{rows}}" wx:key="id" class="roster-card">
        <view class="row"><view class="list-number">{{index + 1}}</view><view class="grow"><view class="person-name">{{item.name}}</view><view class="muted">{{item.extra ? item.extra + ' · ' : ''}}{{item.phone}}</view><view class="muted">{{type === 'logistics' ? '运输单位' : '所属单位'}}：{{item.company}}</view></view></view>
        <view class="row entry-actions"><button class="text-button edit-entry" data-id="{{item.id}}" bindtap="onEdit">编辑</button><button class="text-button danger delete-entry" data-id="{{item.id}}" bindtap="onDelete">删除</button></view>
      </view>
      <view wx:if="{{!rows.length}}" class="roster-empty"><text>尚未添加{{type === 'logistics' ? '车辆和司机' : '人员'}}</text><view class="form-note">每位入场人员均需登记并独立完成培训。</view></view>
    </view>
    <button class="add-list-button add-entry" bindtap="onAdd" hover-class="press"><image class="inline-icon" src="/assets/plus.svg" aria-hidden="true" />添加{{type === 'logistics' ? '车辆及司机' : '人员'}}</button>
    </view>
    <view wx:if="{{type !== 'logistics'}}" class="card form-section accompanying-section">
      <view class="form-heading"><text class="section-title">随行车辆</text><text class="optional-tag">选填</text></view><view class="form-note">带车到访时填写车牌号，可添加多辆车辆。</view>
      <view wx:for="{{draft.accompanyingVehicles}}" wx:key="id" class="field accompanying-field" id="field-accompanying-{{item.id}}">
        <text class="field-label">车牌号 {{index + 1}}</text><view class="row"><input class="grow {{infoErrors['accompanying-' + item.id] ? 'invalid' : ''}}" value="{{item.plate}}" data-id="{{item.id}}" bindinput="onAccompanyingInput" placeholder="例如：粤B12345" maxlength="10" cursor-spacing="120" aria-label="随行车牌号" /><button class="text-button danger delete-accompanying" data-id="{{item.id}}" bindtap="onDeleteAccompanyingVehicle" aria-label="删除此随行车辆">删除</button></view>
        <view wx:if="{{infoErrors['accompanying-' + item.id]}}" class="field-error">{{infoErrors['accompanying-' + item.id]}}</view>
      </view>
      <button class="add-list-button add-accompanying" bindtap="onAddAccompanyingVehicle" hover-class="press"><image class="inline-icon" src="/assets/plus.svg" aria-hidden="true" />添加随行车辆</button>
    </view>
    <button class="text-button demo-data" bindtap="onDemoData" hover-class="press">填入预约与两条演示数据</button>
    <view class="form-note center">演示信息为虚构数据，仅用于体验登记流程。</view>
  </block>
  <block wx:elif="{{step === 2}}">
    <view class="section-title section">请选择访问区域</view><view class="subtitle">可多选，将自动匹配所需的安全培训。</view>
    <view class="stack section">
      <button wx:for="{{areas}}" wx:key="id" class="area-card card {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="onArea" hover-class="press" aria-label="{{item.name}}{{item.selected ? '，已选择' : '，未选择'}}">
        <view class="area-illustration {{item.color}}"><image src="/assets/{{item.icon}}.svg" aria-hidden="true" /></view><view class="grow"><view class="section-title">{{item.name}}</view><view class="muted">{{item.subtitle}}</view><view class="area-caption">{{item.caption}}</view></view><view class="check {{item.selected ? 'checked' : ''}}"><image wx:if="{{item.selected}}" src="/assets/check-white.svg" aria-hidden="true" /></view>
      </button>
    </view>
    <view wx:if="{{taskCount}}" class="info-banner">已选择 {{selectedAreas}} · 将生成 {{taskCount}} 项培训任务</view>
  </block>
  <block wx:else>
    <view class="eyebrow section">READY TO VISIT</view><view class="title">请确认登记信息</view><view class="subtitle">提交后，每位人员需独立完成匹配的全部培训。</view>
    <view class="card section"><view class="row between"><text class="muted">登记类型</text><text>{{title}}</text></view><view class="divider"></view><view class="row between"><text class="muted">{{type === 'logistics' ? '车辆数量' : '到访人数'}}</text><text>{{rows.length}} {{type === 'logistics' ? '辆' : '人'}}</text></view><view class="divider"></view><view class="row between"><text class="muted">访问区域</text><text>{{selectedAreas}}</text></view></view>
    <view wx:for="{{infoSections}}" wx:key="title" class="card section info-summary"><view class="section-title">{{item.title}}</view><view wx:for="{{item.fields}}" wx:for-item="field" wx:key="label" class="summary-field"><text class="muted">{{field.label}}</text><text class="summary-value">{{field.value}}</text></view></view>
    <view class="section-title section">人员与车辆</view><view class="wrap section"><text wx:for="{{rows}}" wx:key="id" class="pill">{{item.name}}</text></view>
    <view wx:if="{{type !== 'logistics'}}" class="card section"><view class="section-title">随行车辆</view><view wx:if="{{draft.accompanyingVehicles.length}}" class="wrap section"><text wx:for="{{draft.accompanyingVehicles}}" wx:key="id" class="pill">{{item.plate}}</text></view><view wx:else class="muted summary-field">未登记随行车辆</view></view>
    <view class="section-title section">每人必修的培训方案</view><view class="card section"><view wx:for="{{planTitles}}" wx:key="*this" class="plan-line"><image class="plan-tick" src="/assets/check-green.svg" aria-hidden="true" /><text>{{item}}</text></view><view class="divider"></view><view class="muted">共 {{taskCount}} 项个人课程任务 · 每项 5 道题 · 80 分通过</view></view>
  </block>
  <view wx:if="{{error && !editorOpen}}" class="error-banner">{{error}}</view>
</view>
<view class="footer registration-footer"><view class="footer-inner"><button class="secondary previous" bindtap="onPrevious" hover-class="press">{{step === 1 ? '返回' : '上一步'}}</button><button wx:if="{{step !== 3}}" class="primary next" bindtap="onNext" hover-class="press">下一步</button><button wx:else class="primary submit-visit" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}" hover-class="press">提交并开始培训</button></view></view>
<view wx:if="{{noticeOpen}}" class="overlay" catchtouchmove="noop">
  <view class="notice-modal"><image class="notice-shield" src="/assets/shield.svg" aria-hidden="true" /><view class="notice-title">访客须知</view><view class="notice-subtitle">共同守护每一次安全到访</view><view class="notice-copy"><view>1. 请如实填写到访人员及车辆信息。</view><view>2. 进入厂区需遵守公司安全管理规定。</view><view>3. 完成所选区域安全培训并通过考试。</view><view>4. 携带访客凭证，听从现场管理人员安排。</view></view><checkbox-group bindchange="onNoticeCheck"><label class="notice-agree"><checkbox value="accepted" checked="{{noticeChecked}}" color="#1768ee" /><text>我已阅读并同意以上须知内容</text></label></checkbox-group><button class="primary accept-notice" disabled="{{!noticeChecked}}" bindtap="onAccept" hover-class="press">确认并继续</button><button class="text-button" bindtap="onCancelNotice">暂不登记</button></view>
</view>
<view wx:if="{{editorOpen}}" class="overlay editor-overlay">
  <view class="editor-sheet"><view class="row between editor-header"><view class="section-title">{{editId ? '编辑' : '添加'}}{{type === 'logistics' ? '车辆' : '人员'}}</view><button class="close-editor" bindtap="onCloseEditor" aria-label="取消编辑并关闭弹窗" hover-class="press"><image class="close-icon" src="/assets/close.svg" aria-hidden="true" /></button></view><scroll-view scroll-y class="editor-scroll">
    <label wx:if="{{type === 'logistics'}}" class="field"><text class="field-label">车牌号 *</text><input value="{{form.plate}}" data-field="plate" bindinput="onInput" placeholder="例如：粤B12345" maxlength="10" aria-label="车牌号" /></label>
    <label class="field"><text class="field-label">{{type === 'logistics' ? '司机姓名' : '姓名'}} *</text><input value="{{type === 'logistics' ? form.driver : form.name}}" data-field="{{type === 'logistics' ? 'driver' : 'name'}}" bindinput="onInput" placeholder="请输入真实姓名" maxlength="30" aria-label="姓名" /></label>
    <label class="field"><text class="field-label">手机号码 *</text><input type="number" value="{{form.phone}}" data-field="phone" bindinput="onInput" placeholder="请输入11位手机号码" maxlength="11" aria-label="手机号码" /></label>
    <view wx:if="{{type === 'contractor'}}" class="field"><text class="field-label">所属单位</text><view class="inherited-company">{{draft.contractorCompany || '请先在施工信息中填写施工单位'}}</view><view class="form-note">自动使用本申请单的施工单位。</view></view>
    <label wx:else class="field"><text class="field-label">{{type === 'logistics' ? '运输单位' : '所属单位'}} *</text><input value="{{form.company}}" data-field="company" bindinput="onInput" placeholder="请输入单位名称" maxlength="60" aria-label="单位名称" /></label>
    <label wx:if="{{type === 'contractor'}}" class="field"><text class="field-label">工种 *</text><input value="{{form.trade}}" data-field="trade" bindinput="onInput" placeholder="例如：电工、焊工" maxlength="30" aria-label="工种" /></label>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view><view class="sheet-bottom-space"></view>
  </scroll-view><button class="primary save-entry" bindtap="onSaveEntry" hover-class="press">保存{{type === 'logistics' ? '车辆' : '人员'}}</button></view>
</view>
