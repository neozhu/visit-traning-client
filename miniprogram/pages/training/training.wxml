<view class="page">
  <view class="eyebrow">SAFETY TRAINING</view><view class="title">继续我的学习</view><view class="subtitle">输入登记时的姓名和手机号，查找待完成的学习任务。</view>
  <view class="card section">
    <label class="field"><text class="field-label">姓名 *</text><input value="{{name}}" data-field="name" bindinput="onInput" placeholder="请输入登记时的姓名" maxlength="30" aria-label="登记姓名" /></label>
    <label class="field"><text class="field-label">手机号码 *</text><input type="number" value="{{phone}}" data-field="phone" bindinput="onInput" placeholder="请输入登记时的11位手机号码" maxlength="11" aria-label="登记手机号码" /></label>
    <view wx:if="{{error}}" class="error-banner" role="alert">{{error}}</view>
    <button class="primary section find-training" bindtap="onFind" hover-class="press">查找学习任务</button>
  </view>
  <block wx:if="{{searched}}">
    <view class="section-title section">{{matches.length ? '待完成的来访培训（' + matches.length + '）' : '查询结果'}}</view>
    <view class="stack section">
      <button wx:for="{{matches}}" wx:key="visitId" class="card training-match" data-visit-id="{{item.visitId}}" data-subject-id="{{item.subjectId}}" bindtap="onMatch" hover-class="press">
        <view class="row between"><view class="section-title">{{item.title}}</view><text class="status active">待完成 {{item.pending}} 项</text></view>
        <view class="muted small">登记时间：{{item.date}}</view><view class="muted">{{item.areas}}</view><view class="divider"></view>
        <view class="row between"><text class="muted small">我的课程已完成 {{item.total - item.pending}} / {{item.total}}</text><text class="training-link">继续学习 <image class="chevron" src="/assets/arrow-right.svg" aria-hidden="true" /></text></view>
      </button>
      <view wx:if="{{!matches.length}}" class="card empty"><image src="/assets/book.svg" aria-hidden="true" /><view class="section-title">没有待完成的学习任务</view><view class="subtitle">请核对登记时的姓名和手机号；尚未登记或已全部通过，也不会显示待完成任务。</view></view>
    </view>
  </block>
</view>
