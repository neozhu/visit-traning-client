<view class="page with-footer">
  <block wx:if="{{visit}}">
    <view class="row between"><view class="title">{{visit.title}}</view><text class="status {{visit.passed ? 'complete' : ''}}">{{visit.passed ? '已完成' : '培训中'}}</text></view><view class="subtitle">{{visit.date}}</view>
    <view class="card section"><view class="row between"><text class="muted">{{visit.type === 'training' ? '培训方案' : '访问区域'}}</text><text>{{visit.type === 'training' ? '通用安全培训' : visit.areaNames}}</text></view><view class="divider"></view><view class="row between"><text class="muted">培训进度</text><text>{{visit.complete}} / {{visit.total}} 项</text></view><view class="divider"></view><view class="muted small">{{visit.type === 'training' ? '培训信息保存在当前设备。' : '已确认访客须知，登记信息保存在当前设备。'}}</view></view>
    <view class="section-title section">登记人员与车辆</view><view class="stack section"><view wx:for="{{rows}}" wx:key="id" class="card"><view class="section-title">{{item.name}}</view><view class="muted">{{item.extra}} {{item.phone}}</view><view class="muted">{{item.company}}</view></view></view>
    <view class="section-title section">关联培训</view><view class="stack section"><button wx:for="{{tasks}}" wx:key="id" class="card detail-task" data-id="{{item.id}}" bindtap="onTask" hover-class="press"><view class="row"><view class="grow"><view>{{item.title}}</view><view class="muted small">{{item.lastResult ? item.lastResult.score + ' 分' : item.done + ' / ' + item.lessonCount + ' 个视频'}}</view></view><text class="status {{item.passed ? 'complete' : 'active'}}">{{item.status}}</text><text class="chevron">›</text></view></button></view>
    <button class="danger-button section delete-visit" bindtap="onDelete">删除本条登记及培训记录</button>
  </block>
  <view wx:else class="card empty"><view class="section-title">记录不存在或已删除</view><view class="subtitle">请返回我的记录查看其他登记。</view></view>
</view>
<view class="footer"><view class="footer-inner"><button class="secondary" bindtap="onRecords">我的记录</button><button wx:if="{{visit}}" class="primary" bindtap="onResume">{{visit.passed ? '查看培训任务' : '继续培训'}}</button></view></view>
