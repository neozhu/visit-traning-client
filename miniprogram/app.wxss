page {
  --primary: #1768ee; --text: #172337; --muted: #65748a; --border: #e4eaf3;
  --surface: #ffffff; --background: #f5f7fb; --green: #168449; --orange: #b75a09; --red: #c83d39;
  background: var(--background); color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 30rpx; line-height: 1.5;
}
view, button, input, scroll-view { box-sizing: border-box; }
button { font-size: 30rpx; line-height: 1.4; border-radius: 16rpx; margin: 0; }
button::after { border: 0; }
button.primary, button.secondary, button.danger-button, button.card { width: 100% !important; }
button.text-button { width: auto !important; font-weight: 400; }
button[disabled] { background: #d9e1ed !important; color: #566477 !important; box-shadow: none !important; }
.press { opacity: .78; }
.page { padding: 36rpx 32rpx 48rpx; max-width: 1100rpx; margin: 0 auto; }
.with-footer { padding-bottom: calc(188rpx + env(safe-area-inset-bottom)); }
.eyebrow { font-size: 22rpx; font-weight: 600; letter-spacing: 4rpx; color: var(--primary); }
.title { font-size: 44rpx; font-weight: 700; line-height: 1.3; letter-spacing: -1rpx; }
.section-title { font-size: 30rpx; font-weight: 650; }
.subtitle { color: var(--muted); margin-top: 12rpx; font-size: 24rpx; }
.muted { color: var(--muted); font-size: 24rpx; }
.small { font-size: 22rpx; }
.row { display: flex; align-items: center; gap: 16rpx; }
.between { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.stack { display: flex; flex-direction: column; gap: 20rpx; }
.card { background: var(--surface); border: 1rpx solid var(--border); border-radius: 24rpx; padding: 28rpx; }
.section { margin-top: 32rpx; }
.primary, .secondary, .danger-button { min-height: 96rpx; padding: 24rpx 30rpx; display: flex; align-items: center; justify-content: center; font-weight: 600; }
.primary { background: var(--primary); color: white; }
.secondary { background: white; border: 2rpx solid #d7e0ee; color: var(--text); }
.danger-button { color: var(--red); border: 2rpx solid #efd1d0; background: white; }
.text-button { color: var(--primary); background: transparent; min-height: 88rpx; padding: 20rpx 12rpx; font-size: 26rpx; }
.text-button.danger { color: var(--red); }
.footer { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: white; border-top: 1rpx solid var(--border); z-index: 5; }
.footer-inner { display: flex; gap: 16rpx; max-width: 1036rpx; margin: auto; }
.footer .primary { flex: 2; }
.footer .secondary { flex: 1; }
.status { display: inline-flex; align-items: center; background: #fff1d9; color: #9f570a; border-radius: 30rpx; padding: 6rpx 16rpx; font-size: 22rpx; white-space: nowrap; }
.status.complete { background: #e5f6eb; color: #12703d; }
.status.active { background: #eaf1ff; color: #1755b9; }
.status.red { background: #fdecea; color: #a62e2b; }
.icon { width: 48rpx; height: 48rpx; flex-shrink: 0; }
.icon-box { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: #edf3fd; flex-shrink: 0; }
.divider { height: 1rpx; background: var(--border); margin: 24rpx 0; }
.pill { border-radius: 12rpx; background: #eff3f8; color: #516178; padding: 6rpx 14rpx; font-size: 24rpx; display: inline-block; }
.error-banner { padding: 20rpx 24rpx; border: 1rpx solid #f0c5bf; border-radius: 16rpx; background: #fff1ed; color: #a22e28; font-size: 26rpx; margin: 20rpx 0; }
.info-banner { padding: 20rpx 24rpx; background: #edf3ff; color: #285796; border-radius: 16rpx; font-size: 26rpx; margin-top: 24rpx; }
.empty { text-align: center; padding: 80rpx 20rpx; }
.empty image { width: 100rpx; height: 100rpx; margin-bottom: 20rpx; opacity: .7; }
.empty .primary { margin-top: 32rpx; }
.field { display: block; margin-top: 24rpx; }
.field-label { display: block; font-size: 26rpx; font-weight: 600; margin-bottom: 12rpx; }
.field input { background: #f4f7fb; border: 2rpx solid #e1e7f0; border-radius: 14rpx; padding: 18rpx 22rpx; height: 94rpx; font-size: 30rpx; }
.segment { display: flex; border-bottom: 1rpx solid var(--border); margin: 24rpx 0; }
.segment button { flex: 1; background: transparent; padding: 24rpx 0; color: var(--muted); border-radius: 0; font-size: 28rpx; border-bottom: 4rpx solid transparent; }
.segment button.selected { color: var(--primary); border-color: var(--primary); font-weight: 600; }
.avatar { width: 80rpx; height: 80rpx; background: #eaf1ff; color: #205bbe; font-size: 32rpx; font-weight: 600; border-radius: 24rpx; display: flex; justify-content: center; align-items: center; flex-shrink: 0; }
.chevron { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.inline-icon { width: 28rpx; height: 28rpx; margin-right: 12rpx; vertical-align: -4rpx; }
.metric { font-size: 52rpx; font-weight: 700; line-height: 1.2; }
.center { text-align: center; }
.wrap { display: flex; flex-wrap: wrap; gap: 12rpx; }
